{
  "name": "Agentic Financial RAG Analyst",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "postCreateCommand": "bash scripts/bootstrap.sh --no-tests",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/Agentic-Financial-RAG-Analyst/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
