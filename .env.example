# Example only. Copy to .env if required; never commit real credentials.
# Defaults aligned with app/generation/ollama_generator.py.
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional expected digest from Ollama /api/tags; the doctor reports the
# installed digest and fails on a mismatch when this value is set.
OLLAMA_MODEL_DIGEST=
LLM_PROVIDER=ollama

# No Hugging Face API key is needed for public model downloads.
# Uncomment only when accessing models requiring authentication.
# HUGGINGFACE_TOKEN=

DATA_RAW_DIR=data/raw
DATA_LOGS_DIR=data/logs
DATA_METADATA_DIR=data/metadata
DEFAULT_MAX_PAGES=5
DEFAULT_LIMIT=10
BRVM_TIMEOUT=60
BRVM_LISTING_PAGES=2
BRVM_REQUEST_DELAY=1
LOG_LEVEL=INFO
